{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["rules/karpathy-guidelines.md", "rules/permissions.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "uv sync": "allow",
      "uv run pytest *": "allow",
      "uv run pytest": "allow",
      "go mod tidy": "allow",
      "go mod download": "allow",
      "go test *": "allow",
      "go test": "allow",
      "go test -v -race -cover *": "allow",
      "go test -v -run Test*": "allow",
      "go test -coverprofile *": "allow",
      "go test -cover *": "allow",
      "go build": "allow",
      "go tool cover *": "allow",
      "make build": "allow",
      "make test": "allow",
      "make test-coverage": "allow",
      "make coverage-check": "allow",
      "make fmt": "allow",
      "make lint": "allow",
      "make tidy": "allow",
      "make all": "allow",
      "make swagger": "allow",
      "make clean": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git add .": "allow",
      "git commit -m *": "allow",
      "git commit --amend": "allow",
      "git push": "allow",
      "git checkout": "allow",
      "git branch": "allow",
      "ls": "allow",
      "ls -la": "allow",
      "find *": "allow",
      "grep *": "allow",
      "grep -r": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "wc": "allow",
      "wc -l": "allow",
      "rg": "allow",
      "todoread": "allow",
      "todowrite": "allow",
      "swag init": "allow",
      "docker compose *": "allow",
      "docker build": "allow",
      "docker run": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "mkfs *": "deny",
      "dd *": "deny",
      "wget *|bash*": "deny",
      "wget *| bash*": "deny",
      "git push --force*": "deny",
      "git push *--force*": "deny",
      "git reset --hard*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.bashrc": "deny",
      "~/.zshrc": "deny",
      "~/.ssh/**": "deny"
    },
    "read": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.git-credentials": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/**": "deny",
      "~/.npmrc": "deny",
      "~/.npm/**": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/Library/Keychains/**": "deny",
      "~/Library/Application Support/**/metamask*/**": "deny",
      "~/Library/Application Support/**/electrum*/**": "deny",
      "~/Library/Application Support/**/exodus*/**": "deny",
      "~/Library/Application Support/**/phantom*/**": "deny",
      "~/Library/Application Support/**/solflare*/*": "deny"
    },
    "glob": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "codesearch": "allow"
  }
}
