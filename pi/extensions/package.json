{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "description": "Vendored pi extensions from github.com/davis7dotsh/my-pi-setup (MIT), symlinked into ~/.pi/agent/extensions.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.216",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@effect/platform-node": "4.0.0-beta.99",
    "acorn": "8.17.0",
    "effect": "4.0.0-beta.99",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@effect/platform-node": {
      "@effect/platform-node-shared": "4.0.0-beta.99"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks --disable-warning=ExperimentalWarning */*.test.ts",
    "lint": "oxlint --import-plugin --deny-warnings ."
  }
}
